{
  // Docs are prose-heavy with wide tables and inline HTML (<details>) in reports.
  "config": {
    "default": true,
    "MD013": false,
    "MD033": { "allowed_elements": ["details", "summary", "br", "img", "p", "a"] },
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD060": false
  },
  "ignores": [".venv/**", ".litellm-venv/**", "projects/**", "worktrees/**", "frontend/node_modules/**", "node_modules/**", "frontend/README.md", "CHANGELOG.md"]
}
